// CapacitySpot — CPD Rail data model
// SQLite (via Prisma). SQLite has no native enums, so status/role/format
// fields are strings with the allowed values documented alongside them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String
  // MEMBER | ADMIN | PROVIDER | ORG
  role             String   @default("MEMBER")
  profession       String?  // HR | Finance | Engineering | Marketing | Cross-industry
  membershipNo     String?  // e.g. HRM-2024-0417
  professionalBody String?  // e.g. Human Resource Managers' Association
  jobTitle         String?
  organisation     String?
  onboarded        Boolean  @default(false)
  // For PROVIDER accounts: the provider profile they manage.
  providerId       String?
  createdAt        DateTime @default(now())

  cycles      Cycle[]
  entries     CpdEntry[]
  enrollments Enrollment[]
}

model Cycle {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label          String   // e.g. "Jan 2026 – Dec 2026"
  startDate      DateTime
  endDate        DateTime
  requiredPoints Int      @default(12)
  isCurrent      Boolean  @default(false)
  certRef        String?  // e.g. CPD-2025-HRM-0417 (issued once complete)
  registrarName  String?
  issuedAt       DateTime?

  entries CpdEntry[]

  @@index([userId])
}

model CpdEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleId       String
  cycle         Cycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  title         String
  // COURSE | WORKSHOP | CONFERENCE | SELF_STUDY | MENTORING | WEBINAR | OTHER
  type          String
  activityDate  DateTime
  pointsClaimed Float
  // VERIFIED | PENDING | NEEDS_PROOF | REJECTED
  status        String   @default("PENDING")
  proofFileName String?
  note          String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([cycleId])
}

model Provider {
  id            String   @id @default(cuid())
  name          String
  initials      String
  type          String   @default("Training company") // Training company | Individual consultant | Institution
  verified      Boolean  @default(true)
  rating        Float    @default(4.8)
  meta          String?  // e.g. "Kampala · 14 courses"
  bio           String?
  createdAt     DateTime @default(now())

  courses Course[]
  bids    Bid[]
}

model Course {
  id           String   @id @default(cuid())
  providerId   String
  provider     Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title        String
  description  String
  profession   String   // HR | Finance | Engineering | Marketing | Cross-industry
  // IN_PERSON | ONLINE | HYBRID
  format       String
  points       Float    @default(0)
  rating       Float    @default(4.8)
  reviewsCount Int      @default(0)
  schedule     String   // e.g. "Starts 4 Mar · 3 days"
  fee          String   // e.g. "UGX 450,000" or "Free"
  seats        Int      @default(30)
  verified     Boolean  @default(true)
  // APPROVED | PENDING | REJECTED — provider-created listings start PENDING.
  status       String   @default("APPROVED")
  createdAt    DateTime @default(now())

  reviews     Review[]
  enrollments Enrollment[]

  @@index([profession])
}

model Review {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name      String
  stars     Int      @default(5)
  text      String
  createdAt DateTime @default(now())

  @@index([courseId])
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  sector       String?  // Public sector | Financial services | Engineering | NGO | ...
  district     String?  // e.g. Kampala
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())

  staff   Staff[]
  tenders Tender[]
}

model Tender {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String
  category       String   // HR | Finance | Engineering | Marketing | Cross-industry
  // In-person | Online | Hybrid | Flexible
  deliveryMode   String   @default("Flexible")
  budget         String   // e.g. "UGX 4,000,000"
  seats          Int      @default(20)
  deadline       DateTime
  // OPEN | CLOSED | AWARDED
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())

  bids Bid[]

  @@index([organizationId])
}

model Bid {
  id         String   @id @default(cuid())
  tenderId   String
  tender     Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  amount     String   // e.g. "UGX 3,600,000"
  proposal   String
  docFileName String?
  // DRAFT | SUBMITTED | SHORTLISTED | ACCEPTED | REJECTED
  status     String   @default("SUBMITTED")
  createdAt  DateTime @default(now())

  @@unique([tenderId, providerId])
  @@index([providerId])
}

model Staff {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  jobTitle       String?
  profession     String?
  membershipNo   String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // ENROLLED | COMPLETED | CANCELLED
  status    String   @default("ENROLLED")
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
}
